# custom.hal
# Loaded after main StepConf HAL - safe to override spindle feedback here

# Load components first (order matters for addf)
loadrt lowpass names=spindle_lowpass
loadrt mult2   names=spindle_mult

addf spindle_lowpass servo-thread
addf spindle_mult   servo-thread

# Tuning
setp spindle_lowpass.gain 0.02     # Increase to 0.03-0.05 if bar responds too slowly; decrease if noisy
setp spindle_mult.in1 60.0         # RPS to RPM

# Override the original direct raw RPS connection
unlinkp spindle.0.speed-in         # Removes encoder.0.velocity => spindle.0.speed-in from main HAL

# Now safely insert filtered path
net spindle-velocity-feedback-rps => spindle_lowpass.in
net spindle_rps_filtered spindle_lowpass.out => spindle.0.speed-in   # Filtered RPS for G95/threading

# Derive RPM for display (branches from filtered RPS)
net spindle_rps_filtered => spindle_mult.in0
net spindle_rpm_filtered spindle_mult.out

# Reinforce index pulse for threading sync (single-pin setup)
net spindle-phase-a => encoder.0.phase-Z

# At-speed generator (compares RPM values)
loadrt near names=spindle_near
addf spindle_near servo-thread
setp spindle_near.scale 1.05       # ~5% tolerance; adjust to 1.02-1.10 as needed

net spindle-cmd-rpm     => spindle_near.in1
net spindle_rpm_filtered => spindle_near.in2
net spindle-at-speed    <= spindle_near.out
