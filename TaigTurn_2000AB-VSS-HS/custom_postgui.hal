# Include your custom_postgui HAL commands here
# This file will not be overwritten when you run stepconf again

# custom_postgui.hal
# Connect filtered spindle RPM to Gmoccapy's spindle bar
# (Run AFTER GUI loads, so gmoccapy pins exist)

# Optional: If you want absolute/positive RPM only (good for lathe display)
# loadrt abs names=spindle_abs_post
# addf spindle_abs_post servo-thread
# net spindle_rpm_filtered spindle_mult.out => spindle_abs_post.in
# net spindle_rpm_abs     spindle_abs_post.out => gmoccapy.spindle_feedback_bar

# Simple direct connection (use this first)
net spindle_rpm_filtered spindle_mult.out => gmoccapy.spindle_feedback_bar

# Bonus: Connect at-speed if you want the LED to work too
net spindle-at-speed => gmoccapy.spindle_at_speed_led